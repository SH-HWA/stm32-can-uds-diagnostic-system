#define BH1750_ADDR 0x46

uint16_t lux = 0;
uint8_t bh1750_buf[2];

uint8_t light_mode = 0; // 0: AUTO, 1: FORCE ON, 2: FORCE OFF
uint8_t btn_prev_state = GPIO_PIN_SET;

// 진단기용 상태 관련 변수들
uint16_t current_dtc = 0x0000; // 0x0000: 정상, 0xB101: B1001 고장코드
uint8_t fault_injected = 0;   // 0: 정상, 1: 고장 상태

char lcd_buf[16]; // LCD 텍스트 출력용 버퍼

// CAN 송신 관련 구조체 및 변수 선언
CAN_TxHeaderTypeDef TxHeader;
uint8_t TxData[8];
uint32_t TxMailbox;

// 기본 오토라이트 동작 임계값 (기본 100 lux)
uint16_t auto_light_threshold = 100;
