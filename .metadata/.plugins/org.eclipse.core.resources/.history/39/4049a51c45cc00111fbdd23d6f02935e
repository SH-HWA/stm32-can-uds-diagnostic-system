#define BH1750_ADDR 0x46

uint16_t lux = 0;
uint8_t bh1750_buf[2];

// 0: AUTO, 1: FORCE ON, 2: FORCE OFF
uint8_t light_mode = 0;

// 버튼 입력을 위한 변수
uint8_t btn_prev_state = GPIO_PIN_SET;
/* USER CODE END PV */

