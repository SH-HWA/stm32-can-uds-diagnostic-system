/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_CAN1_Init();
  MX_I2C1_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
    // 1. CAN 필터 설정 (모든 ID 허용)
    CAN_FilterTypeDef sFilterConfig;

    sFilterConfig.FilterBank = 0;
    sFilterConfig.FilterMode = CAN_FILTERMODE_IDMASK;
    sFilterConfig.FilterScale = CAN_FILTERSCALE_32BIT;
    sFilterConfig.FilterIdHigh = 0x0000;
    sFilterConfig.FilterIdLow = 0x0000;
    sFilterConfig.FilterMaskIdHigh = 0x0000;
    sFilterConfig.FilterMaskIdLow = 0x0000;
    sFilterConfig.FilterFIFOAssignment = CAN_RX_FIFO0;
    sFilterConfig.FilterActivation = ENABLE;
    sFilterConfig.SlaveStartFilterBank = 14;

    if (HAL_CAN_ConfigFilter(&hcan1, &sFilterConfig) != HAL_OK)
    {
        Error_Handler();
    }

    // 2. CAN 시작
    if (HAL_CAN_Start(&hcan1) != HAL_OK)
    {
        Error_Handler();
    }

    // 3. 수신 인터럽트 활성화
    HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);

    // 4. TX Header 설정
    TxHeader.StdId = 0x100;
    TxHeader.ExtId = 0x01;
    TxHeader.RTR = CAN_RTR_DATA;
    TxHeader.IDE = CAN_ID_STD;
    TxHeader.DLC = 8;
    TxHeader.TransmitGlobalTime = DISABLE;

    // 5. BH1750 센서 초기화 (Power On & 연속 고해상도 측정 모드)
    uint8_t cmd = 0x01; // Power On
    HAL_I2C_Master_Transmit(&hi2c1, BH1750_ADDR, &cmd, 1, 100);

    cmd = 0x10; // Continuously H-Resolution Mode (1 lx 단위 측정)
    HAL_I2C_Master_Transmit(&hi2c1, BH1750_ADDR, &cmd, 1, 100);

    // 6. I2C CLCD 초기화
    lcd_init();
    lcd_clear();
    lcd_put_cur(0, 0);
    lcd_send_string("AutoLight ECU");
    HAL_Delay(1000);
    lcd_clear();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

	  /* USER CODE BEGIN 3 */
	      // 1. 파란색 스위치 버튼(PC13) 입력 감지 및 모드 전환 (Active LOW)
	      uint8_t btn_curr_state = HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13);

	      if (btn_prev_state == GPIO_PIN_SET && btn_curr_state == GPIO_PIN_RESET)
	      {
	          light_mode = (light_mode + 1) % 3; // 0:AUTO -> 1:ON -> 2:OFF
	          HAL_Delay(50); // 버튼 디바운싱
	      }
	      btn_prev_state = btn_curr_state;

	      // 2. BH1750 조도 데이터 수신 (I2C 응답 실패 시 LCD가 멈추지 않도록 타임아웃 10ms 설정)
	      if (HAL_I2C_Master_Receive(&hi2c1, BH1750_ADDR, bh1750_buf, 2, 10) == HAL_OK)
	      {
	          lux = ((uint16_t)bh1750_buf[0] << 8) | bh1750_buf[1];
	          lux = (uint16_t)(lux / 1.2);
	      }

	      // 3. 모드별 오토라이트 제어 (PA5 내장 LED)
	      uint8_t light_state = 0;
	      if (light_mode == 1) // FORCE ON
	      {
	          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);
	          light_state = 1;
	      }
	      else if (light_mode == 2) // FORCE OFF
	      {
	          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET);
	          light_state = 0;
	      }
	      else // AUTO 모드
	      {
	          if (lux < 100)
	          {
	              HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);
	              light_state = 1;
	          }
	          else
	          {
	              HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET);
	              light_state = 0;
	          }
	      }

	      // 4. CLCD 화면 실시간 업데이트 (정확히 16자리 포맷 맞춤)
	      // 1번째 줄: LUX 값 표시 (예: "LUX: 120 lx     ")
	      sprintf(lcd_buf, "LUX: %-5u lx   ", lux);
	      lcd_put_cur(0, 0);
	      lcd_send_string(lcd_buf);

	      // 2번째 줄: 모드 및 점등 상태 표시 (예: "M:AUTO  LIGHT:ON ")
	      char *mode_str = (light_mode == 0) ? "AUTO" : (light_mode == 1) ? "ON  " : "OFF ";
	      char *state_str = (light_state == 1) ? "ON " : "OFF";
	      sprintf(lcd_buf, "M:%-4s LIGHT:%-3s", mode_str, state_str);
	      lcd_put_cur(1, 0);
	      lcd_send_string(lcd_buf);

	      // 5. CAN 진단 메시지 전송 (ID: 0x100)
	      TxData[0] = (uint8_t)(lux >> 8);
	      TxData[1] = (uint8_t)(lux & 0xFF);
	      TxData[2] = light_state;
	      TxData[3] = light_mode;

	      if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0)
	      {
	          HAL_CAN_AddTxMessage(&hcan1, &TxHeader, TxData, &TxMailbox);
	      }
	      else
	      {
	          HAL_CAN_AbortTxRequest(&hcan1, CAN_TX_MAILBOX0 | CAN_TX_MAILBOX1 | CAN_TX_MAILBOX2);
	      }

	      HAL_Delay(100);
	  }
	  /* USER CODE END 3 */
}

