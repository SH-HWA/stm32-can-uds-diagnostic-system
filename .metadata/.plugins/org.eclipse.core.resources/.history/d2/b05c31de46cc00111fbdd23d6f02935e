#define BH1750_ADDR 0x46

uint16_t lux = 0;
uint8_t bh1750_buf[2];

uint8_t light_mode = 0; // 0: AUTO, 1: FORCE ON, 2: FORCE OFF
uint8_t btn_prev_state = GPIO_PIN_SET;

char lcd_buf[16]; // LCD 텍스트 출력용 버퍼

// CAN 송신 관련 구조체 및 변수 선언
