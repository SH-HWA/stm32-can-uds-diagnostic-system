/* USER CODE BEGIN 4 */
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    CAN_RxHeaderTypeDef rxHeader;
    uint8_t rxData[8];

    if (hcan->Instance == CAN1)
    {
        if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &rxHeader, rxData) == HAL_OK)
        {
            // PC 대시보드 모드 제어 명령 (CAN ID: 0x200)
            if (rxHeader.StdId == 0x200)
            {
                if (rxData[0] <= 2)
                {
                    light_mode = rxData[0];
                }
            }

            // 진단 스캐너 요청 명령 (CAN ID: 0x7E0)
            else if (rxHeader.StdId == 0x7E0)
            {
                uint8_t service_id = rxData[0];

                // [Service 0x19] Read DTC (고장 코드 읽기 요청)
                if (service_id == 0x19)
                {
                    CAN_TxHeaderTypeDef diagTxHeader;
                    uint8_t diagData[8] = {0};
                    uint32_t txMailbox;

                    diagTxHeader.StdId = 0x7E8; // 진단 응답 ID
                    diagTxHeader.RTR = CAN_RTR_DATA;
                    diagTxHeader.IDE = CAN_ID_STD;
                    diagTxHeader.DLC = 8;

                    // 응답 데이터: [DTC High, DTC Low, Fault Status, Lux High, Lux Low, 0, 0, 0]
                    diagData[0] = (current_dtc >> 8) & 0xFF;
                    diagData[1] = current_dtc & 0xFF;
                    diagData[2] = fault_injected;
                    diagData[3] = (lux >> 8) & 0xFF;
                    diagData[4] = lux & 0xFF;

                    HAL_CAN_AddTxMessage(hcan, &diagTxHeader, diagData, &txMailbox);
                }

                // [Service 0x14] Clear DTC (고장 코드 소거)
                else if (service_id == 0x14)
                {
                    current_dtc = 0x0000;
                    fault_injected = 0;
                }

                // [Service 0x2F] Fault Injection (가상 고장 주입/해제)
                else if (service_id == 0x2F)
                {
                    if (rxData[1] == 0x01) {
                        fault_injected = 1;
                        current_dtc = 0xB101; // DTC B1001 (조도센서 단선/단락) 부여
                    } else {
                        fault_injected = 0;
                        current_dtc = 0x0000;
                    }
                }
            }
        }
    }
}
